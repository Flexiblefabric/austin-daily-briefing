  "services": {
    "control_plane": {
      "platform": "Google Sheets + Google Apps Script",
      "status": "live"
    },
    "email_delivery": {
      "provider": "Resend",
      "status": "live",
      "from": "Austin Daily Briefing <briefing@austindailybriefing.com>",
      "reply_to": "briefing@austindailybriefing.com",
      "source_path": "apps-script/ResendTransport.gs"
    },
    "reply_routing": {
      "provider": "Cloudflare Email Routing",
      "status": "live",
      "public_address": "briefing@austindailybriefing.com",
      "private_destination": "configured externally; intentionally not stored"
    },
    "website": {
      "provider": "GitHub Pages",
      "status": "live",
      "domain": "austindailybriefing.com",
      "workflow_path": ".github/workflows/pages.yml",
      "source_path": "site/"
    }
  },
  "automation": {
    "subscriber_processor": {
      "cadence": "every 6 hours",
      "status": "live",
      "verification": "manual/external"
    },
    "daily_generation": {
      "cadence": "08:00 America/Chicago",
      "status": "live",
      "verification": "manual/external"
    },
    "welcome_dispatch": {
      "cadence": "hourly",
      "status": "live",
      "function": "dispatchQueuedWelcomeMessagesViaResendV1",
      "source_path": "apps-script/ResendTransport.gs"
    },
    "daily_dispatch": {
      "cadence": "hourly",
      "status": "live",
      "function": "dispatchQueuedDailyBriefingsViaResendV1",
      "source_path": "apps-script/ResendTransport.gs"
    },
    "documentation_sync": {
      "cadence": "on authoritative registry changes to main",
      "status": "live",
      "function": "python scripts/docs_sync.py update",
      "source_path": "scripts/docs_sync.py"
    }
  },
  "runtime_properties": [
    {
