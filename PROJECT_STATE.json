      "sensitivity": "config",
      "purpose": "welcome dispatcher CONTROLLED/LIVE mode"
    },
    {
      "name": "ADB_RESEND_WELCOME_ALLOWLIST",
      "sensitivity": "private_config",
      "purpose": "controlled welcome-delivery allowlist"
    },
    {
      "name": "ADB_RESEND_DAILY_MODE",
      "sensitivity": "config",
      "purpose": "daily dispatcher CONTROLLED/LIVE mode"
    },
    {
      "name": "ADB_RESEND_DAILY_ALLOWLIST",
      "sensitivity": "private_config",
      "purpose": "controlled daily-delivery allowlist"
    },
    {
      "name": "ADB_SENDER_CHANGE_APPROVAL",
      "sensitivity": "config",
      "purpose": "manual sender-change announcement approval gate"
    }
  ],
  "documentation": {
    "scope": "internal technical documentation only",
    "registry": "PROJECT_STATE.json",
    "changelog": "docs/CHANGELOG.md",
    "generated_status": "docs/PROJECT_STATUS.md",
    "cutover_runbook": "docs/resend-cutover.md",
    "sync_script": "scripts/docs_sync.py"
  },
  "governance": {
    "registry_is_authoritative": true,
    "secrets_policy": "Store secret and private configuration names only; never store values.",
    "changelog_order": "newest_first",
    "changelog_required_for": [
      "production architecture changes",
      "development-to-production promotions",
      "production dependency replacements",
      "data storage or routing changes",
      "new production subsystems",
      "rollbacks and migrations"
    ]
  }
