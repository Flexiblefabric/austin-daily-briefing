{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adb:editorial-handoff:1",
  "title": "ADB-EDITORIAL-HANDOFF-1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "edition_date", "source_revision", "expected_profile_count", "editions", "selection_bundle"],
  "properties": {
    "schema": {"const": "ADB-EDITORIAL-HANDOFF-1"},
    "edition_date": {"type": "string", "format": "date"},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "expected_profile_count": {"type": "integer", "minimum": 0},
    "editions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "editorial", "bindings"],
        "properties": {
          "profile_id": {"type": "string", "minLength": 1},
          "editorial": {
            "type": "object",
            "description": "Exact ADB-DAILY-RENDER-JS-1.0 structured editorial payload, independently rendered and validated. No profile identity, operational status, delivery metadata, HTML or text bodies.",
            "required": ["date", "preheader", "pulse", "weather", "featured", "topStories", "austinAhead", "footer"],
            "additionalProperties": false,
            "properties": {
              "date": {"type": "string", "format": "date"},
              "preheader": {"type": "string", "minLength": 1},
              "pulse": {"type": "string", "minLength": 1},
              "weather": {"type": "object"},
              "featured": {"type": "object"},
              "topStories": {"type": "array", "minItems": 1},
              "underTheRadar": {"type": ["object", "null"]},
              "moreForYou": {"type": "array"},
              "austinAhead": {"type": "array"},
              "footer": {"type": "object"},
              "fridayRecap": {"type": "array", "maxItems": 3},
              "correction": {"type": "string"}
            }
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["section", "index", "key", "category"],
              "properties": {
                "section": {"enum": ["Featured Top Story", "Top Story", "Under the Radar", "More for You", "Austin Ahead", "This Week in Austin"]},
                "index": {"type": "integer", "minimum": 0},
                "key": {"type": "string", "minLength": 1},
                "category": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "selection_bundle": {
      "type": "object",
      "description": "Existing docs/selection-notes.md bundle. JSON-only ADB-SELECTION-NOTE-1 envelopes; publisher generates transport suffix. Profiles include volume, preferences, summary_style and why_it_matters_length read from DEV. Semantic JS gate and established Python gate apply. Zero audience requires empty profiles and rows.",
      "required": ["run_id", "cutoff", "history_complete", "history_window_start", "published_history", "profiles", "rows"]
    }
  }
}
