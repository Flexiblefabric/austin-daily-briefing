{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADB Friday synthesis evidence record 1.0",
  "description": "An actual synthesis/evaluation attempt, never a placeholder for pending work. JSON shape alone does not establish an editorial pass.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "supersedes_run_id": {"type": ["string", "null"]},
    "mode": {"enum": ["synthetic", "production_observation", "steady_state"]},
    "scenario": {"enum": ["quiet", "dominant", "fragmented", "production"]},
    "variant": {"type": ["string", "null"]},
    "recorded_at": {"type": "string", "format": "date-time"},
    "week": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {"type": "string", "minLength": 1},
        "end": {"type": "string", "minLength": 1},
        "cutoff": {"type": "string", "format": "date-time"},
        "timezone": {"const": "America/Chicago"}
      },
      "required": ["start", "end", "cutoff", "timezone"]
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository_commit": {"type": "string", "minLength": 1},
        "v2_spec": {"type": "string", "minLength": 1},
        "daily_prompt": {"type": "string", "minLength": 1},
        "friday_spec": {"const": "ADB-FRI-SYNTH-1.0"},
        "rubric": {"const": "ADB-FRI-VALIDATE-1.0"}
      },
      "required": ["repository_commit", "v2_spec", "daily_prompt", "friday_spec", "rubric"]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weekly_packet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
          "required": ["path", "sha256"]
        },
        "daily_v2_outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
            "required": ["path", "sha256"]
          },
          "minItems": 1
        },
        "history_seed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
          "required": ["path", "sha256"]
        },
        "synthesis_prompt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
          "required": ["path", "sha256"]
        },
        "reviewer_key": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
              "required": ["path", "sha256"]
            },
            {"type": "null"}
          ]
        }
      },
      "required": ["weekly_packet", "daily_v2_outputs", "history_seed", "synthesis_prompt", "reviewer_key"]
    },
    "separation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constructor": {"type": "string", "minLength": 1},
        "synthesizer": {"type": "string", "minLength": 1},
        "evaluator": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "key_withheld": {"type": "boolean"},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 0}
      },
      "required": ["constructor", "synthesizer", "evaluator", "method", "key_withheld", "limitations"]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "section_included": {"type": "boolean"},
        "omission_reason": {"type": ["string", "null"]},
        "opening": {"type": "string"},
        "arcs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "arc_id": {"type": "string", "minLength": 1},
              "heading": {"type": ["string", "null"]},
              "text": {"type": "string", "minLength": 1}
            },
            "required": ["arc_id", "heading", "text"]
          },
          "minItems": 0,
          "maxItems": 3
        },
        "exact_recap": {"type": "string"},
        "word_count": {"type": "integer", "minimum": 0},
        "full_edition_word_count": {"type": ["integer", "null"], "minimum": 0},
        "reading_time_method": {"type": ["string", "null"]}
      },
      "required": [
        "section_included",
        "omission_reason",
        "opening",
        "arcs",
        "exact_recap",
        "word_count",
        "full_edition_word_count",
        "reading_time_method"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["synthetic_packet", "verified_public_source"]},
          "publisher": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "publication_time": {"type": ["string", "null"]},
          "access_time": {"type": ["string", "null"]},
          "access_status": {"enum": ["fixture_read", "live_read", "unavailable"]},
          "supporting_note": {"type": "string", "minLength": 1},
          "used_for": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 0}
        },
        "required": [
          "source_id",
          "kind",
          "publisher",
          "locator",
          "publication_time",
          "access_time",
          "access_status",
          "supporting_note",
          "used_for"
        ]
      },
      "minItems": 0
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "kind": {"enum": ["fact", "interpretation"]},
          "development_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 0},
          "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "prior_shared_coverage_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 0},
          "context_exception": {"enum": ["none", "changes_understanding", "prevents_misleading_omission"]},
          "exception_reason": {"type": ["string", "null"]},
          "new_context_disclosure": {"type": ["string", "null"]},
          "relationship_support": {"type": ["string", "null"]},
          "pattern_minimum_departure_reason": {"type": ["string", "null"]},
          "uncertainty_handling": {"type": "string", "minLength": 1}
        },
        "required": [
          "claim_id",
          "location",
          "text",
          "kind",
          "development_ids",
          "source_ids",
          "prior_shared_coverage_refs",
          "context_exception",
          "exception_reason",
          "new_context_disclosure",
          "relationship_support",
          "pattern_minimum_departure_reason",
          "uncertainty_handling"
        ]
      },
      "minItems": 0
    },
    "displayed_source_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "supports_locations": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "labels": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
        },
        "required": ["group_id", "supports_locations", "source_ids", "labels"]
      },
      "minItems": 0
    },
    "scorecard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "factual_fidelity": {"$ref": "#/$defs/score20"},
        "narrative_usefulness": {"$ref": "#/$defs/score15"},
        "unsupported_inference_control": {"$ref": "#/$defs/score15"},
        "source_traceability": {"$ref": "#/$defs/score10"},
        "pattern_causation_discipline": {"$ref": "#/$defs/score10"},
        "material_uncertainty": {"$ref": "#/$defs/score10"},
        "no_filler": {"$ref": "#/$defs/score10"},
        "voice_restraint": {"$ref": "#/$defs/score5"},
        "structure_readability": {"$ref": "#/$defs/score5"}
      },
      "required": [
        "factual_fidelity",
        "narrative_usefulness",
        "unsupported_inference_control",
        "source_traceability",
        "pattern_causation_discipline",
        "material_uncertainty",
        "no_filler",
        "voice_restraint",
        "structure_readability"
      ]
    },
    "total_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "hard_fail_checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fabricated_fact": {"$ref": "#/$defs/check"},
        "material_unsupported_conclusion": {"$ref": "#/$defs/check"},
        "unsupported_causation": {"$ref": "#/$defs/check"},
        "false_pattern": {"$ref": "#/$defs/check"},
        "unlogged_source": {"$ref": "#/$defs/check"},
        "invalid_new_context": {"$ref": "#/$defs/check"}
      },
      "required": [
        "fabricated_fact",
        "material_unsupported_conclusion",
        "unsupported_causation",
        "false_pattern",
        "unlogged_source",
        "invalid_new_context"
      ]
    },
    "disposition": {"enum": ["pass_candidate", "revise", "fail", "incomplete"]},
    "human_review": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reviewer": {"type": "string", "minLength": 1},
            "reviewed_at": {"type": "string", "format": "date-time"},
            "timing": {"enum": ["prepublication", "postpublication", "test_review"]},
            "decision": {"enum": ["accepted", "revise", "reject"]},
            "notes": {"type": "string", "minLength": 1}
          },
          "required": ["reviewer", "reviewed_at", "timing", "decision", "notes"]
        }
      ]
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 0},
    "next_action": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version",
    "run_id",
    "supersedes_run_id",
    "mode",
    "scenario",
    "variant",
    "recorded_at",
    "week",
    "versions",
    "inputs",
    "separation",
    "output",
    "sources",
    "claims",
    "displayed_source_groups",
    "scorecard",
    "total_score",
    "hard_fail_checks",
    "disposition",
    "human_review",
    "limitations",
    "next_action"
  ],
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "pass_candidate"}}},
      "then": {
        "properties": {
          "total_score": {"type": "number", "minimum": 85},
          "scorecard": {
            "properties": {
              "factual_fidelity": {"properties": {"rating": {"type": "integer", "minimum": 3}, "points": {"type": "number"}}},
              "narrative_usefulness": {"properties": {"rating": {"type": "integer", "minimum": 3}, "points": {"type": "number"}}},
              "unsupported_inference_control": {"properties": {"rating": {"type": "integer", "minimum": 3}, "points": {"type": "number"}}},
              "source_traceability": {"properties": {"rating": {"type": "integer", "minimum": 3}, "points": {"type": "number"}}},
              "pattern_causation_discipline": {"properties": {"rating": {"type": "integer", "minimum": 3}, "points": {"type": "number"}}},
              "material_uncertainty": {"properties": {"rating": {"type": "integer", "minimum": 3}, "points": {"type": "number"}}},
              "no_filler": {"properties": {"rating": {"type": "integer", "minimum": 3}, "points": {"type": "number"}}},
              "voice_restraint": {"properties": {"rating": {"type": "integer", "minimum": 3}, "points": {"type": "number"}}},
              "structure_readability": {"properties": {"rating": {"type": "integer", "minimum": 3}, "points": {"type": "number"}}}
            }
          },
          "hard_fail_checks": {
            "properties": {
              "fabricated_fact": {"properties": {"result": {"const": "clear"}}},
              "material_unsupported_conclusion": {"properties": {"result": {"const": "clear"}}},
              "unsupported_causation": {"properties": {"result": {"const": "clear"}}},
              "false_pattern": {"properties": {"result": {"const": "clear"}}},
              "unlogged_source": {"properties": {"result": {"const": "clear"}}},
              "invalid_new_context": {"properties": {"result": {"const": "clear"}}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "synthetic"}}},
      "then": {"properties": {"scenario": {"enum": ["quiet", "dominant", "fragmented"]}}}
    },
    {
      "if": {"properties": {"mode": {"enum": ["production_observation", "steady_state"]}}},
      "then": {"properties": {"scenario": {"const": "production"}}}
    }
  ],
  "$defs": {
    "score5": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weight": {"const": 5},
        "rating": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
        "points": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
        "reason": {"type": "string", "minLength": 1}
      },
      "required": ["weight", "rating", "points", "reason"]
    },
    "score10": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weight": {"const": 10},
        "rating": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
        "points": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "reason": {"type": "string", "minLength": 1}
      },
      "required": ["weight", "rating", "points", "reason"]
    },
    "score15": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weight": {"const": 15},
        "rating": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
        "points": {"type": ["number", "null"], "minimum": 0, "maximum": 15},
        "reason": {"type": "string", "minLength": 1}
      },
      "required": ["weight", "rating", "points", "reason"]
    },
    "score20": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weight": {"const": 20},
        "rating": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
        "points": {"type": ["number", "null"], "minimum": 0, "maximum": 20},
        "reason": {"type": "string", "minLength": 1}
      },
      "required": ["weight", "rating", "points", "reason"]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"result": {"enum": ["clear", "fail", "not_assessed"]}, "reason": {"type": "string", "minLength": 1}},
      "required": ["result", "reason"]
    }
  }
}
